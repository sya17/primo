{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,

    "modules-left": ["image#launcher", "hyprland/workspaces", "custom/layout"],
    "modules-center": ["clock", "custom/hubstatus"],
    "modules-right": [
        "custom/recorder",
        "tray",
        "group/sys",
        "custom/activity",
        "custom/prs",
        "bluetooth",
        "custom/vpn",
        "network",
        "pulseaudio",
        "custom/powerprofile",
        "battery",
        "custom/notifications",
        "custom/nightlight",
        "custom/power"
    ],

    // Primo mark, rendered in the theme's colours by theme-switch.
    "image#launcher": {
        "exec": "echo ~/.config/hypr/logo.svg",
        "interval": 86400,
        "size": 16,
        "on-click": "~/.config/hypr/scripts/launcher.sh toggle",
        "tooltip": false
    },

    // iOS page-dots: small dots, the active workspace stretches into a pill.
    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "on-click": "activate",
        "format": "",
        "persistent-workspaces": { "*": 4 }
    },

    "custom/layout": {
        "exec": "~/.config/hypr/scripts/layout-cycle.sh status",
        "return-type": "json",
        "interval": 2,
        "signal": 10,
        "format": "{icon}",
        "format-icons": { "dwindle": "\uf009", "master": "\uf0db", "scrolling": "\uf07e", "monocle": "\uf2d0" },
        "on-click": "~/.config/hypr/scripts/layout-cycle.sh"
    },

    // Click: the time hub (calendar, reminders, clock, focus, notes). Right-click: new note.
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/hub.sh toggle",
        "on-click-right": "~/.config/hypr/scripts/hub.sh new-note"
    },

    // A running timer or focus session, next to the clock; hidden when there is none.
    "custom/hubstatus": {
        "exec": "~/.config/hypr/scripts/hub.sh status",
        "return-type": "json",
        "interval": 1,
        "hide-empty-text": true,
        "on-click": "~/.config/hypr/scripts/hub.sh clock"
    },

    // CPU / memory live in a drawer: hover the chip icon to reveal them.
    "group/sys": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 350,
            "children-class": "sys-child",
            "transition-left-to-right": false
        },
        "modules": ["custom/sys", "cpu", "memory"]
    },
    "custom/sys": { "format": "", "tooltip": false },

    // Hover: the three busiest apps (measured every 30 s). Click: open Activity.
    "custom/activity": {
        "exec": "~/.config/hypr/scripts/activity.py --top",
        "return-type": "json",
        "interval": 30,
        "format": "󰐰",
        "on-click": "~/.config/hypr/scripts/activity.sh toggle"
    },
    "cpu": { "format": "{usage}%", "tooltip": false },
    "memory": { "format": "{}%", "tooltip-format": "{used:0.1f} / {total:0.1f} GiB" },

    // Native Bluetooth module: hidden when there is no adapter. Click opens the manager.
    "bluetooth": {
        "format": "\uf293",
        "format-off": "\uf293",
        "format-disabled": "\uf293",
        "format-connected": "\uf293 {num_connections}",
        "tooltip-format": "{controller_alias}  {status}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}   {device_battery_percentage}%",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "",
        "format-icons": [""],
        "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": { "default": ["", "", ""] },
        "tooltip-format": "Volume {volume}%",
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}   {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },

    // Click: open the notification center (swaync). Right-click: do not disturb.
    "custom/notifications": {
        "exec": "~/.config/hypr/scripts/notifications.sh",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "\uf0f3",
            "none": "\uf0f3",
            "inhibited-notification": "\uf1f6",
            "inhibited-none": "\uf1f6",
            "dnd-notification": "\uf1f6",
            "dnd-none": "\uf1f6"
        },
        "on-click": "~/.config/hypr/scripts/notifications.sh panel",
        "on-click-right": "~/.config/hypr/scripts/notifications.sh dnd",
        "escape": true
    },

    // Red timer while a screen recording is running; hidden otherwise. Click to stop.
    // Pull requests waiting for your review (needs `gh auth login`); hidden when none. Click: open them.
    "custom/prs": {
        "exec": "~/.config/hypr/scripts/gh-prs.sh status",
        "return-type": "json",
        "interval": 300,
        "format": "\uf407 {}",
        "hide-empty-text": true,
        "on-click": "~/.config/hypr/scripts/gh-prs.sh open"
    },

    // A shield while a VPN is connected; hidden otherwise. Click: Settings > VPN.
    "custom/vpn": {
        "exec": "~/.config/hypr/scripts/vpn.sh status",
        "return-type": "json",
        "interval": 5,
        "signal": 13,
        "hide-empty-text": true,
        "on-click": "python3 ~/.config/hypr/scripts/primo-settings.py --page vpn"
    },

    "custom/recorder": {
        "exec": "~/.config/hypr/scripts/record.sh status",
        "return-type": "json",
        "interval": 1,
        "signal": 11,
        "hide-empty-text": true,
        "on-click": "~/.config/hypr/scripts/record.sh stop"
    },

    // Power mode (power-profiles-daemon). Click to cycle Power Saver > Balanced > Performance.
    "custom/powerprofile": {
        "exec": "~/.config/hypr/scripts/powerprofile.sh status",
        "exec-if": "command -v powerprofilesctl",
        "return-type": "json",
        "interval": 10,
        "signal": 12,
        "format": "{icon}",
        "format-icons": { "power-saver": "\uf06c", "balanced": "\uf24e", "performance": "\uf0e4" },
        "on-click": "~/.config/hypr/scripts/powerprofile.sh cycle"
    },

    "custom/nightlight": {
        "exec": "~/.config/hypr/scripts/nightlight.sh status",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "format": "{icon}",
        "format-icons": { "off": "", "on": "" },
        "on-click": "~/.config/hypr/scripts/nightlight.sh toggle"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/power-menu.sh"
    },

    "tray": { "icon-size": 15, "spacing": 8 }
}
