{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "custom/layout"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/recorder",
        "tray",
        "group/sys",
        "network",
        "pulseaudio",
        "battery",
        "custom/notifications",
        "custom/nightlight",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "",
        "on-click": "~/.config/hypr/scripts/launcher.sh toggle",
        "tooltip": false
    },

    // iOS page-dots: small dots, the active workspace stretches into a pill.
    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "on-click": "activate",
        "format": "",
        "persistent-workspaces": { "*": 4 }
    },

    "custom/layout": {
        "exec": "~/.config/hypr/scripts/layout-cycle.sh status",
        "return-type": "json",
        "interval": 2,
        "signal": 10,
        "format": "{icon}",
        "format-icons": { "dwindle": "\uf009", "master": "\uf0db", "scrolling": "\uf07e", "monocle": "\uf2d0" },
        "on-click": "~/.config/hypr/scripts/layout-cycle.sh"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": { "format": { "today": "<span color='#ffffff'><b>{}</b></span>" } }
    },

    // CPU / memory live in a drawer: hover the chip icon to reveal them.
    "group/sys": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 350,
            "children-class": "sys-child",
            "transition-left-to-right": false
        },
        "modules": ["custom/sys", "cpu", "memory"]
    },
    "custom/sys": { "format": "", "tooltip": false },
    "cpu": { "format": "{usage}%", "tooltip": false },
    "memory": { "format": "{}%", "tooltip-format": "{used:0.1f} / {total:0.1f} GiB" },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "",
        "format-disconnected": "",
        "format-icons": [""],
        "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "tooltip-format": "Volume {volume}%",
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}   {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },

    // Click: open the notification center (swaync). Right-click: do not disturb.
    "custom/notifications": {
        "exec": "~/.config/hypr/scripts/notifications.sh",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "\uf0f3",
            "none": "\uf0f3",
            "inhibited-notification": "\uf1f6",
            "inhibited-none": "\uf1f6",
            "dnd-notification": "\uf1f6",
            "dnd-none": "\uf1f6"
        },
        "on-click": "~/.config/hypr/scripts/notifications.sh panel",
        "on-click-right": "~/.config/hypr/scripts/notifications.sh dnd",
        "escape": true
    },

    // Red timer while a screen recording is running; hidden otherwise. Click to stop.
    "custom/recorder": {
        "exec": "~/.config/hypr/scripts/record.sh status",
        "return-type": "json",
        "interval": 1,
        "signal": 11,
        "hide-empty-text": true,
        "on-click": "~/.config/hypr/scripts/record.sh stop"
    },

    "custom/nightlight": {
        "exec": "~/.config/hypr/scripts/nightlight.sh status",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "format": "{icon}",
        "format-icons": { "off": "", "on": "" },
        "on-click": "~/.config/hypr/scripts/nightlight.sh toggle"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/power-menu.sh"
    },

    "tray": { "icon-size": 15, "spacing": 8 }
}
