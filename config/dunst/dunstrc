# Structure and behaviour only. Colours and font live in dunstrc.d/10-theme.conf
# (generated by scripts/theme-switch).
[global]
    monitor = 0
    follow = none
    width = 300
    height = (0, 200)
    origin = top-right
    offset = (15, 15)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1

    indicate_hidden = yes
    transparency = 0
    padding = 15
    horizontal_padding = 15
    frame_width = 1
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120

    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    stack_duplicates = true
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/wofi --dmenu -p dunst
    browser = /usr/bin/xdg-open
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    timeout = 6
    default_icon = dialog-information

[urgency_critical]
    timeout = 0
    default_icon = dialog-warning
