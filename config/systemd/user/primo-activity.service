[Unit]
Description=Primo activity monitor
Documentation=https://github.com/sya17/primo/blob/main/docs/ARCHITECTURE.md
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=dbus
BusName=dev.primo.Activity
ExecStart=/usr/bin/python3 %h/.config/hypr/scripts/activity.py --daemon
Restart=on-failure
RestartPreventExitStatus=69
RestartSec=1

[Install]
WantedBy=graphical-session.target
