[Unit]
Description=Primo workspace overview
Documentation=https://github.com/sya17/primo/blob/main/docs/ARCHITECTURE.md
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=dbus
BusName=dev.primo.Overview
ExecStart=/usr/bin/python3 %h/.config/hypr/scripts/overview.py --daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
