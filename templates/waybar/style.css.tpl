/* GENERATED by scripts/theme-switch ({{name}}) from templates/waybar/style.css.tpl. Do not edit.
   Colours and font-family come from theme.css. */
@import "theme.css";

* {
    border: none;
    border-radius: 0;
    font-size: 13px;
    font-weight: 600;
    min-height: 0;
}

window#waybar { background: transparent; }

tooltip {
    background: alpha(@base, 0.94);
    border: 1px solid alpha(@text, 0.12);
    border-radius: {{rounding}}px;
}
tooltip label { color: @text; padding: 2px 4px; }

/* ── Islands ─────────────────────────────────────────── */
.modules-left, .modules-center, .modules-right {
    background-color: alpha(@base, 0.82);
    border: 1px solid alpha(@text, 0.08);
    border-radius: {{bar_radius}}px;
    padding: 0 6px;
}

#custom-launcher, #custom-layout, #clock, #network, #pulseaudio, #battery, #tray,
#custom-dnd, #custom-nightlight, #custom-power, #custom-sys, #cpu, #memory {
    padding: 0 9px;
    margin: 0;
    color: @text;
    transition: color 0.25s ease, background-color 0.25s ease;
}

/* ── Launcher ────────────────────────────────────────── */
#custom-launcher {
    font-size: 15px;
    color: @accent;
    padding-left: 10px;
    padding-right: 8px;
}

/* ── Workspaces: iOS page dots ───────────────────────── */
#workspaces { margin: 0 4px 0 0; }
#workspaces button {
    min-width: 7px;
    min-height: 7px;
    margin: 10px 3px;     /* keep (bar height - 2*margin) = dot size so the dots stay round */
    padding: 0;
    border-radius: 999px;
    background-color: alpha(@text, 0.28);
    transition: all 0.35s cubic-bezier(0.23, 1, 0.32, 1);
}
#workspaces button label { font-size: 0; min-height: 0; padding: 0; margin: 0; } /* empty label would force a tall button */
#workspaces button:hover { background-color: alpha(@text, 0.55); }
#workspaces button.active {
    min-width: 22px;
    background-color: @accent;
}
#workspaces button.urgent { background-color: @red; }

#custom-layout { color: @subtext; padding-left: 4px; }
#custom-layout:hover { color: @accent2; }

/* ── Clock ───────────────────────────────────────────── */
#clock { padding: 0 14px; letter-spacing: 0.3px; }

/* ── Right side ──────────────────────────────────────── */
#custom-sys { color: @subtext; }
#cpu, #memory { color: @subtext; font-weight: 500; }
#network      { color: @cyan; }
#pulseaudio   { color: @yellow; }
#pulseaudio.muted { color: @overlay; }
#battery      { color: @green; }
#battery.charging { color: @accent; }
#battery.warning:not(.charging)  { color: @orange; }
#battery.critical:not(.charging) { color: @red; animation: pulse 1s ease-in-out infinite alternate; }

#custom-dnd.off, #custom-nightlight.off { color: @overlay; }
#custom-dnd.on          { color: @red; }
#custom-nightlight.on   { color: @orange; }

#custom-power { color: @subtext; padding-right: 11px; }
#custom-power:hover { color: @red; }
#custom-launcher:hover, #network:hover, #pulseaudio:hover,
#custom-dnd:hover, #custom-nightlight:hover { color: @accent2; }

@keyframes pulse { to { opacity: 0.45; } }
