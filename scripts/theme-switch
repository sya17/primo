#!/usr/bin/env bash
# Render a theme into the config directories and reload the running apps.
#
# Usage: theme-switch [--no-reload] <theme | dark | light | toggle>
#        theme-switch --list | --current
#
# dark / light apply the theme last used in that mode (first available one otherwise);
# toggle flips the current theme to the other mode.
set -euo pipefail

# Resolve the repo even when invoked through a symlink (e.g. ~/.local/bin/hypr-theme).
self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")/.." && pwd)"
themes_dir="$root/themes"
tpl_dir="$root/templates"
out_dir="$root/config"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprland-dotfiles"

die() { echo "error: $*" >&2; exit 1; }

list_themes() { for d in "$themes_dir"/*/theme.conf; do basename "$(dirname "$d")"; done; }

theme_mode() { sed -n 's/^mode=\([a-z]*\).*/\1/p' "$themes_dir/$1/theme.conf" | head -n1; }

# Theme to use for a mode: last used one, else the first theme declaring that mode.
pick_for_mode() {
    local mode="$1" last t
    last="$(cat "$state_dir/last-$mode" 2>/dev/null || true)"
    if [[ -n "$last" && -f "$themes_dir/$last/theme.conf" && "$(theme_mode "$last")" == "$mode" ]]; then
        echo "$last"; return
    fi
    for t in $(list_themes); do [[ "$(theme_mode "$t")" == "$mode" ]] && { echo "$t"; return; }; done
    die "no $mode theme found in $themes_dir"
}

reload=1
case "${1:-}" in
    --list)    for t in $(list_themes); do printf '%-20s %s\n' "$t" "$(theme_mode "$t")"; done; exit 0 ;;
    --current) cat "$state_dir/current" 2>/dev/null || echo "(none)"; exit 0 ;;
    --no-reload) reload=0; shift ;;
    -h|--help|"") sed -n '2,9p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

theme="${1:-}"
case "$theme" in
    dark|light) theme="$(pick_for_mode "$theme")" ;;
    toggle)
        cur="$(cat "$state_dir/current" 2>/dev/null || true)"
        if [[ "$(theme_mode "${cur:-}")" == "light" ]]; then theme="$(pick_for_mode dark)"
        else theme="$(pick_for_mode light)"; fi ;;
esac
conf="$themes_dir/$theme/theme.conf"
[[ -f "$conf" ]] || die "unknown theme '$theme' (available: $(list_themes | tr '\n' ' '))"

# ---- parse key=value ----
declare -A v
while IFS='=' read -r key val; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    val="${val%% #*}"             # allow trailing " # comment"
    v[$key]="${val%"${val##*[![:space:]]}"}"
done < "$conf"

# ---- validate before touching any output file ----
required=(name mode shadow lock_brightness lock_tint bar_radius input_rounding base mantle crust surface0 surface1 overlay text subtext accent accent2
          red orange yellow green cyan blue magenta font_sans font_mono font_icon
          gaps_in gaps_out border_size rounding blur_size blur_passes)
missing=(); for key in "${required[@]}"; do [[ -n "${v[$key]:-}" ]] || missing+=("$key"); done
(( ${#missing[@]} == 0 )) || die "theme '$theme' is missing: ${missing[*]}"
for key in shadow base mantle crust surface0 surface1 overlay text subtext accent accent2 red orange yellow green cyan blue magenta; do
    [[ "${v[$key]}" =~ ^[0-9a-fA-F]{6}$ ]] || die "theme '$theme': $key must be 6 hex digits without '#', got '${v[$key]}'"
done

[[ "${v[mode]}" == dark || "${v[mode]}" == light ]] || die "theme '$theme': mode must be dark or light"

# ---- derived values ----
v[menu_radius]="$(( ${v[rounding]} + 6 ))"   # launcher / menu window = a bit rounder than its rows
# <key>_rgb = "r, g, b" so templates can write rgba({{base_rgb}}, 0.9) (GTK4 has no alpha()).
for key in base mantle crust surface0 surface1 overlay text subtext accent accent2 red orange yellow green cyan blue magenta shadow; do
    hex="${v[$key]}"
    v[${key}_rgb]="$((16#${hex:0:2})), $((16#${hex:2:2})), $((16#${hex:4:2}))"
done
wp="${v[wallpaper]:-}"
[[ -n "$wp" && "$wp" != /* ]] && wp="$themes_dir/$theme/$wp"
[[ -f "$wp" ]] || wp="$HOME/Pictures/wallpaper.jpg"
v[wallpaper_path]="$wp"

# ---- render ----
render() { # template -> output
    local tpl="$1" out="$2" content key
    content="$(<"$tpl")"
    for key in "${!v[@]}"; do
        content="${content//\{\{$key\}\}/${v[$key]}}"
    done
    if grep -qo '{{[a-z_0-9]*}}' <<<"$content"; then
        die "unresolved placeholder in $tpl: $(grep -o '{{[a-z_0-9]*}}' <<<"$content" | sort -u | tr '\n' ' ')"
    fi
    mkdir -p "$(dirname "$out")"
    printf '%s\n' "$content" > "$out"
}

render "$tpl_dir/hypr/theme.lua.tpl"          "$out_dir/hypr/theme.lua"
render "$tpl_dir/hypr/hyprpaper.conf.tpl"     "$out_dir/hypr/hyprpaper.conf"
render "$tpl_dir/hypr/hyprlock-theme.conf.tpl" "$out_dir/hypr/hyprlock-theme.conf"
render "$tpl_dir/waybar/style.css.tpl"        "$out_dir/waybar/style.css"
render "$tpl_dir/waybar/theme.css.tpl"        "$out_dir/waybar/theme.css"
render "$tpl_dir/wofi/style.css.tpl"          "$out_dir/wofi/style.css"
render "$tpl_dir/wofi/menu.css.tpl"          "$out_dir/wofi/menu.css"
render "$tpl_dir/swayosd/style.css.tpl"       "$out_dir/swayosd/style.css"
render "$tpl_dir/dunst/10-theme.conf.tpl"     "$out_dir/dunst/dunstrc.d/10-theme.conf"
render "$tpl_dir/kitty/theme.conf.tpl"        "$out_dir/kitty/theme.conf"

mkdir -p "$state_dir"
echo "$theme" > "$state_dir/current"
echo "$theme" > "$state_dir/last-${v[mode]}"
echo "Applied theme: ${v[name]:-$theme} (${v[mode]})"

(( reload )) || exit 0

# ---- tell GTK4 / libadwaita / browsers which colour scheme to use ----
if command -v gsettings >/dev/null; then
    gsettings set org.gnome.desktop.interface color-scheme "prefer-${v[mode]}" 2>/dev/null || true
fi

# ---- reload whatever is running ----
running() { pgrep -x "$1" >/dev/null; }

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl reload >/dev/null
    if running hyprpaper; then
        pkill -x hyprpaper
        sleep 0.2
    fi
    setsid -f hyprpaper >/dev/null 2>&1
fi
running waybar && pkill -SIGUSR2 -x waybar
running dunst  && dunstctl reload
if running swayosd-server; then pkill -x swayosd-server; sleep 0.2; setsid -f swayosd-server --style "$HOME/.config/swayosd/style.css" >/dev/null 2>&1; fi
running kitty  && pkill -SIGUSR1 -x kitty
exit 0
