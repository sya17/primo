#!/usr/bin/env python3
"""primo: look at the state of the Primo desktop from a terminal (and from scripts: every command has --json).

    primo status              one screen: version, theme, mode, resident services, health
    primo doctor              every check, grouped; problems first (--verbose lists the passing ones too)
    primo features            what Primo offers and whether each feature works on this machine
    primo config path         the folders and files Primo reads
    primo config show         the settings in effect and where each comes from (private links and snippet texts hidden)
    primo config validate     check every settings file; exit 2 naming the file and line of the first problem in each
    primo update check        is this checkout ready for a manual `git pull`? (read-only; --remote also asks GitHub for the latest release)
    primo restore ID          show what restoring a snapshot would change; --apply restores it, --rollback JOURNAL undoes it
    primo snapshot            copy your Primo settings into a private snapshot (--dry-run lists what it would take); also: list, show ID, remove ID

Only `primo snapshot` (under ~/.local/share/primo/snapshots) and `primo restore --apply`/`--rollback` (the Primo files named in the preview, plus
~/.local/share/primo/recovery) write anything; everything else is read-only: a fix is only ever
printed as a command for you to run.
Exit codes: 0 healthy, 1 warnings, 2 at least one failure, 64 usage error.
Colours are off when NO_COLOR is set, when the output is not a terminal, or with --no-color.
"""
import argparse
import json
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "config" / "hypr" / "scripts"))
import config_core as cc  # noqa: E402
import doctor_core as dc  # noqa: E402
import recovery_core as rc  # noqa: E402
import update_core as uc  # noqa: E402

MARK = {dc.PASS: "ok", dc.WARNING: "!!", dc.FAIL: "XX", dc.SKIPPED: "--"}
COLOUR = {dc.PASS: "32", dc.WARNING: "33", dc.FAIL: "31", dc.SKIPPED: "2"}


def version():
    try:
        m = re.search(r"^##\s+\[?(\d+\.\d+\.\d+)", (ROOT / "CHANGELOG.md").read_text(), re.M)
        return m.group(1) if m else "unknown"
    except OSError:
        return "unknown"


class Out:
    def __init__(self, colour):
        self.colour = colour

    def c(self, code, text):
        return f"\033[{code}m{text}\033[0m" if self.colour else text

    def mark(self, status):
        return self.c(COLOUR[status], MARK[status])


def make_out(args):
    colour = not (args.no_color or os.environ.get("NO_COLOR") or not sys.stdout.isatty() or os.environ.get("TERM") == "dumb")
    return Out(colour)


def state_value(name, default=""):
    try:
        return (cc.state_home() / "hyprland-dotfiles" / name).read_text().strip() or default
    except OSError:
        return default


def cmd_doctor(args):
    results = dc.run_all()
    if args.category:
        wanted = args.category.lower()
        results = [r for r in results if r.category.lower() == wanted]
        if not results:
            print(f"primo: no category '{args.category}'. Categories: {', '.join(dc.CATEGORIES)}", file=sys.stderr)
            return 64
    sm = dc.summary(results)
    if args.json:
        print(json.dumps({"version": 1, "health": sm["health"], "counts": sm["counts"], "checks": dc.to_dicts(results), "features": dc.feature_states(results)}, indent=2))
        return sm["exit_code"]
    out = make_out(args)
    print(out.c("1", "Primo Doctor"))
    for cat in dc.CATEGORIES:
        rows = [r for r in results if r.category == cat]
        if not rows:
            continue
        problems = [r for r in rows if r.status in (dc.WARNING, dc.FAIL)]
        shown = rows if args.verbose else problems
        passed = sum(1 for r in rows if r.status == dc.PASS)
        print(f"\n{out.c('1', cat)}  {out.c('2', f'{passed} ok' + (f', {len(problems)} to look at' if problems else ''))}")
        for r in shown:
            print(f"  {out.mark(r.status)}  {r.title}: {r.message}")
            if r.fix and r.status in (dc.WARNING, dc.FAIL):
                print(f"       try: {r.fix}")
    c = sm["counts"]
    print(f"\nHealth: {out.c(COLOUR[dc.PASS] if sm['health'] == 'HEALTHY' else COLOUR[dc.WARNING] if sm['health'] == 'DEGRADED' else COLOUR[dc.FAIL], sm['health'])}"
          f"  ({c[dc.PASS]} ok, {c[dc.WARNING]} warnings, {c[dc.FAIL]} failures, {c[dc.SKIPPED]} skipped)")
    return sm["exit_code"]


def _size(n):
    return "" if n is None else f"{n} B" if n < 1024 else f"{n / 1024:.1f} KiB"


def cmd_snapshot(args):
    action = args.action or "create"
    out = make_out(args)
    if action in ("show", "remove") and not args.id:
        print(f"primo snapshot {action}: needs a snapshot id (see `primo snapshot list`)", file=sys.stderr)
        return 64
    if action not in ("create", "list", "show", "remove"):
        print("primo snapshot: use create (the default), list, show ID or remove ID", file=sys.stderr)
        return 64
    try:
        if action == "list":
            rows = rc.list_snapshots()
            if args.json:
                print(json.dumps({"version": 1, "snapshots": [r.__dict__ for r in rows]}, indent=2))
                return 0
            for r in rows:
                print(f"  {r.id}  {r.created or '-':19}  {r.count} files  {_size(r.bytes):>9}  {'complete' if r.complete else out.c('33', r.problem or 'incomplete')}")
            if not rows:
                print("  no snapshots yet; `primo snapshot` takes one")
            elif len([r for r in rows if r.id[0].isdigit()]) > rc.SOFT_LIMIT:
                print(f"  {len(rows)} snapshots (more than {rc.SOFT_LIMIT}): remove old ones with `primo snapshot remove ID`")
            return 0
        if action == "show":
            manifest, problems = rc.load_snapshot(args.id)
            if args.json:
                print(json.dumps({"version": 1, "manifest": manifest.to_dict(), "problems": problems}, indent=2))
            else:
                print(f"{manifest.id}  {manifest.created}  {'complete' if manifest.complete else 'INCOMPLETE'}")
                for name, cls, state, size in rc.plan_rows(manifest):
                    print(f"  {state:20} {name:26} {cls:10} {_size(size)}")
                for p_ in problems:
                    print(f"  problem: {p_}")
            return 2 if problems else 0
        if action == "remove":
            rc.remove_snapshot(args.id)
            print(f"removed {args.id}")
            return 0
        plan = rc.plan_snapshot(include_sensitive=args.include_sensitive)
        if args.dry_run:
            rows, done, code = rc.plan_rows(plan), None, 0
        else:
            done = rc.create_snapshot(plan, revision=version())
            rows, code = rc.plan_rows(done), 0 if done.complete else 2
        if args.json:
            print(json.dumps({"version": 1, "dry_run": bool(args.dry_run), "snapshot": done.id if done else None, "complete": done.complete if done else None,
                              "rows": [dict(zip(("name", "class", "state", "size"), r)) for r in rows]}, indent=2))
            return code
        print(out.c("1", "Snapshot preview" if args.dry_run else f"Snapshot {done.id}" + ("" if done.complete else "  INCOMPLETE")))
        for name, cls, state, size in rows:
            print(f"  {state:20} {name:26} {cls:10} {_size(size)}")
        left = [r for r in rows if r[2] == "sensitive-skipped"]
        if left and not args.include_sensitive:
            print(f"\n  {len(left)} file(s) with possible secrets left out; add --include-sensitive to take them too")
        if not args.dry_run and not done.complete:
            print("  this snapshot cannot be restored: a file kept changing while it was copied; take another one")
        return code
    except rc.RecoveryError as e:
        print(f"primo snapshot: {e}", file=sys.stderr)
        return 2


def cmd_restore(args):
    out = make_out(args)
    try:
        if args.rollback:
            res = rc.rollback_restore(args.rollback)
            if args.json:
                print(json.dumps({"version": 1, "rolled_back": res.rolled_back, "undone": list(res.applied), "kept": [list(k) for k in res.skipped]}, indent=2))
            else:
                print(out.c("1", f"Rollback of {args.rollback}") + ("" if res.rolled_back else "  INCOMPLETE"))
                for n in res.applied:
                    print(f"  put back  {n}")
                for n, why in res.skipped:
                    print(f"  kept      {n}: {why}")
            return 0 if res.rolled_back else 2
        if not args.id:
            print("primo restore: needs a snapshot id (see `primo snapshot list`), or --rollback JOURNAL", file=sys.stderr)
            return 64
        plan = rc.plan_restore(args.id, only=args.only or None, include_machine=args.include_machine)
        res = rc.apply_restore(plan) if args.apply else None
    except rc.RecoveryError as e:
        print(f"primo restore: {e}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps({"version": 1, "snapshot": plan.snapshot_id, "applied": bool(res),
                          "actions": [a.__dict__ for a in plan.actions],
                          "result": None if res is None else {"journal": res.journal, "written": list(res.applied), "failed": res.failed,
                                                              "complete": res.complete, "skipped": [list(k) for k in res.skipped]}}, indent=2))
        return 0 if res is None or res.complete else (2 if res.failed else 1)
    print(out.c("1", f"Restore of {plan.snapshot_id}" if res else f"Restore preview for {plan.snapshot_id}") + ("" if res else out.c("2", "  (nothing is written; add --apply)")))
    for a in plan.actions:
        print(f"  {a.action:8} {a.name:26} {a.reason}")
    todo = [a for a in plan.actions if a.action in ("create", "replace")]
    if res is None:
        print(f"\n  {len(todo)} file(s) would change" if todo else "\n  nothing to restore")
        return 0
    print(f"\n  written: {', '.join(res.applied) or 'nothing'}")
    for n, why in res.skipped:
        if why in ("changed-since-preview",) or why.startswith("the file is"):
            print(f"  left alone: {n}: {why}")
    print(f"  journal: {res.journal}  (undo with: primo restore --rollback {res.journal})")
    if res.failed:
        print(out.c("31", f"  stopped at {res.failed}; the files written so far can be put back with the command above"))
        return 2
    if any(n in ("hub",) for n in res.applied):
        print("  note: the time hub keeps its data in memory; log out and in (or restart it) to load restored reminders")
    if any(n in ("current", "wallpaper", "wallpaper-current") for n in res.applied):
        print("  note: the running desktop is unchanged; apply a restored theme or wallpaper yourself (hypr-theme NAME)")
    return 0 if res.complete else 1


def cmd_update(args):
    if args.action != "check":
        print("primo update: use `primo update check`", file=sys.stderr)
        return 64
    out = make_out(args)
    report = uc.preflight()
    remote = None
    if args.remote:
        remote = uc.check_release(uc.current_version(), url=uc.releases_url(os.environ.get("PRIMO_RELEASES_URL", "")))
    if args.json:
        print(json.dumps({"version": 1, "verdict": report.verdict, "revision": report.revision, "branch": report.branch, "ahead": report.ahead,
                          "behind": report.behind, "checks": [c.__dict__ for c in report.checks], "remote": remote.__dict__ if remote else None}, indent=2))
        return report.exit_code()
    colour = {uc.OK: COLOUR[dc.PASS], uc.WARN: COLOUR[dc.WARNING], uc.BLOCK: COLOUR[dc.FAIL]}
    mark = {uc.OK: "ok", uc.WARN: "!!", uc.BLOCK: "XX"}
    print(out.c("1", "Update check") + out.c("2", "  (read-only: nothing is fetched, pulled or changed)"))
    for c in report.checks:
        print(f"  {out.c(colour[c.level], mark[c.level])}  {c.title}: {c.detail}")
        if c.hint and c.level != uc.OK:
            print(f"       try: {c.hint}")
    if remote:
        print("\n" + out.c("1", "Latest release") + out.c("2", "  (asked GitHub just now, nothing was sent but this request)"))
        words = {"newer": f"{remote.latest} is available (you have {remote.current})", "current": f"you have the latest release, {remote.latest}",
                 "ahead": f"your version {remote.current} is newer than the latest release {remote.latest}", "unknown": remote.detail or "no answer",
                 "offline": remote.detail, "rate-limited": remote.detail, "redirected": remote.detail, "too-large": remote.detail, "malformed": remote.detail}
        print(f"  {out.c(COLOUR[dc.WARNING] if remote.status in ('newer',) else COLOUR[dc.PASS] if remote.status in ('current', 'ahead') else COLOUR[dc.SKIPPED], remote.status)}  {words[remote.status]}")
        if remote.last_known:
            print(f"       last known answer: {remote.last_known}; that is a hint, not a check")
        if remote.name or remote.published:
            print(f"       {remote.name}  {remote.published}".rstrip())
        if remote.url:
            print(f"       {remote.url}")
        if remote.breaking:
            print("       the notes mention a breaking change: read them before updating")
        if remote.notes:
            print("       release notes (text from the internet, shown as plain text):")
            for line in remote.notes.splitlines()[:30]:
                print("         | " + line)
    word = {"ready": "READY", "ready-with-warnings": "READY, with warnings", "blocked": "BLOCKED"}[report.verdict]
    print(f"\n  {out.c(colour[uc.OK] if report.verdict == 'ready' else colour[uc.WARN] if report.verdict != 'blocked' else colour[uc.BLOCK], word)}"
          "  Primo does not update itself: when you are ready, run `git pull` in the checkout.")
    return report.exit_code()


def cmd_status(args):
    results = dc.run_all()
    sm = dc.summary(results)
    theme = state_value("current", "none")
    mode_name = "none"
    try:
        import modes_core
        st = modes_core.current()
        if st:
            mode_name = f"{st['name']}, {modes_core.elapsed(st) // 60} min"
    except Exception:
        pass
    resident = [r for r in results if r.id in {f"service.{f}" for f in ("launcher", "switcher", "overview", "hub", "activity")}]
    running = sum(1 for r in resident if r.status == dc.PASS)
    hypr = next((r.message for r in results if r.id == "session.hyprland"), "")
    data = {"version": version(), "theme": theme, "mode": mode_name, "hyprland": hypr, "resident_services": {"running": running, "total": len(resident)},
            "health": sm["health"], "counts": sm["counts"]}
    if args.json:
        print(json.dumps(data, indent=2))
        return sm["exit_code"]
    out = make_out(args)
    print(f"{out.c('1', 'Primo ' + data['version'])}   {out.c(COLOUR[dc.PASS] if sm['health'] == 'HEALTHY' else COLOUR[dc.WARNING] if sm['health'] == 'DEGRADED' else COLOUR[dc.FAIL], sm['health'])}")
    for key, value in (("Theme", theme), ("Mode", mode_name), ("Hyprland", hypr or "not detected"), ("Services", f"{running} of {len(resident)} resident services running")):
        print(f"  {key:<10}{value}")
    c = sm["counts"]
    if c[dc.WARNING] or c[dc.FAIL]:
        print(f"  {'Attention':<10}{c[dc.WARNING]} warning{'s' if c[dc.WARNING] != 1 else ''}, {c[dc.FAIL]} failure{'s' if c[dc.FAIL] != 1 else ''}. Run: primo doctor")
    return sm["exit_code"]


def cmd_features(args):
    results = dc.run_all()
    feats = dc.feature_states(results)
    if args.json:
        print(json.dumps({"version": 1, "features": feats}, indent=2))
        return 0
    out = make_out(args)
    colour = {"working": COLOUR[dc.PASS], "stopped": COLOUR[dc.WARNING], "unavailable": COLOUR[dc.FAIL]}
    for f in feats:
        print(f"  {out.c(colour[f['state']], f['state']):<{11 + (9 if out.colour else 0)}} {f['name']:<26} {f['summary']}")
        for n in f["notes"]:
            print(f"  {'':<11} {out.c('2', n)}")
    return 0


HIDDEN = "<hidden>"


def redact(value, key=""):
    """Links can carry a private token and snippets can hold passwords: never print them."""
    if isinstance(value, dict):
        return {k: redact(v, k) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v, key) for v in value]
    if isinstance(value, str) and (key in ("url", "text") or re.match(r"(?i)https?://", value)):
        return HIDDEN
    return value


def config_defaults():
    import modes_core
    import overview_core
    import workflow_core
    return {"modes": modes_core.DEFAULT_MODES, "workflow": workflow_core.DEFAULTS, "activity": {}, "overview": overview_core.DEFAULTS,
            "ui": {"version": 1, "reduce_motion": False, "reduce_transparency": False}}


def config_files():
    """Each known file with its state: ok (value), absent, or invalid (ConfigError). Reads only; never copies or writes."""
    out = []
    for name, path, kind in cc.known_files():
        try:
            value = cc.load(path, kind)
            out.append({"name": name, "path": path, "status": "absent" if value is None else "ok", "value": value, "error": None})
        except cc.ConfigError as e:
            out.append({"name": name, "path": path, "status": "invalid", "value": None, "error": e})
    return out


def error_dict(e):
    return {"error": e.problem, "line": e.line, "column": e.column, "hint": e.hint} if e else {}


def cmd_config(args):
    if args.action not in ("path", "show", "validate"):
        print("primo: config needs one of: path, show, validate", file=sys.stderr)
        return 64
    files = config_files()
    invalid = [f for f in files if f["status"] == "invalid"]
    code = 2 if invalid else 0
    out = make_out(args)
    if args.action == "path":
        folders = {"config": str(cc.config_home()), "data": str(cc.data_home()), "state": str(cc.state_home())}
        if args.json:
            print(json.dumps({"version": 1, "folders": folders, "files": [{"name": f["name"], "path": str(f["path"]), "exists": f["status"] != "absent"} for f in files]}, indent=2))
            return 0
        for k, v in folders.items():
            print(f"  {k + ' folder':<15}{v}")
        for f in files:
            print(f"  {f['name']:<15}{f['path']}" + (out.c("2", "  (absent)") if f["status"] == "absent" else ""))
        return 0
    if args.action == "validate":
        if args.json:
            print(json.dumps({"version": 1, "valid": not invalid, "files": [{"name": f["name"], "path": str(f["path"]), "status": f["status"], **error_dict(f["error"])}
                                                                         for f in files]}, indent=2))
            return code
        for f in files:
            if f["status"] == "invalid":
                print(f"  {out.mark(dc.FAIL)}  {f['error']}")
            else:
                print(f"  {out.mark(dc.PASS if f['status'] == 'ok' else dc.SKIPPED)}  {f['path']}" + ("" if f["status"] == "ok" else out.c("2", "  absent")))
        print("\nAll settings files are valid." if not invalid else f"\n{len(invalid)} file{'s' if len(invalid) != 1 else ''} to fix. Primo uses the defaults for "
              "a broken file and keeps a copy before saving over it.")
        return code
    defaults = config_defaults()
    shown = []
    # hub data and other valid files are not settings: `primo config path` lists them
    files = [f for f in files if f["name"] in defaults or f["status"] == "invalid"]
    for f in files:
        entry = {"name": f["name"], "path": str(f["path"])}
        if f["status"] == "invalid":
            entry.update(status="invalid", **error_dict(f["error"]))
        elif isinstance(defaults[f["name"]], dict):
            value = f["value"] or {}
            entry["value"] = redact({**defaults[f["name"]], **value})
            entry["source"] = {k: (str(f["path"]) if k in value else "default") for k in entry["value"]}
        else:
            entry["value"] = redact(f["value"] if f["status"] == "ok" else defaults[f["name"]])
            entry["from"] = str(f["path"]) if f["status"] == "ok" else "defaults"
        shown.append(entry)
    if args.json:
        print(json.dumps({"version": 1, "files": shown}, indent=2, ensure_ascii=False))
        return code
    for e, f in zip(shown, files):
        print(out.c("1", e["name"]) + out.c("2", f"  {e['path']}"))
        if f["status"] == "invalid":
            print(f"  {out.mark(dc.FAIL)}  {f['error']}")
        elif "source" in e:
            for k, v in e["value"].items():
                print(f"  {k:<14}{json.dumps(v, ensure_ascii=False)}" + out.c("2", "  (default)" if e["source"][k] == "default" else ""))
        else:
            print(f"  {json.dumps(e['value'], ensure_ascii=False)}" + out.c("2", "  (defaults)" if e["from"] == "defaults" else ""))
        print()
    return code


def main(argv=None):
    p = argparse.ArgumentParser(prog="primo", description="Look at the state of the Primo desktop. Nothing here changes the system.",
                                epilog="Examples:\n  primo status\n  primo doctor --category services\n  primo doctor --json | jq '.checks[] | select(.status != \"pass\")'",
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"primo {version()}")
    sub = p.add_subparsers(dest="cmd", metavar="command")
    for name, fn, helptext in (("status", cmd_status, "version, theme, mode, services and health in one screen"),
                               ("doctor", cmd_doctor, "run every check (read-only) and suggest fixes"),
                               ("features", cmd_features, "list Primo's features and whether each works here")):
        sp = sub.add_parser(name, help=helptext, description=helptext)
        sp.add_argument("--json", action="store_true", help="machine-readable output on stdout")
        sp.add_argument("--no-color", action="store_true", help="never use colours")
        if name == "doctor":
            sp.add_argument("--category", help="only one of: " + ", ".join(dc.CATEGORIES))
            sp.add_argument("-v", "--verbose", action="store_true", help="also list the checks that pass")
        sp.set_defaults(fn=fn)
    sp = sub.add_parser("config", help="the settings files: where they are, what is in effect, whether they are valid",
                        description="path: the folders and files Primo reads. show: the settings in effect and where each comes from. "
                                    "validate: check every file (exit 2 when one is broken). Reads only.")
    sp.add_argument("action", nargs="?", metavar="path|show|validate")
    sp.add_argument("--json", action="store_true", help="machine-readable output on stdout")
    sp.add_argument("--no-color", action="store_true", help="never use colours")
    sp.set_defaults(fn=cmd_config)
    sp = sub.add_parser("snapshot", help="copy your Primo settings into a private snapshot",
                        description="create (the default): copy the settings Primo owns into ~/.local/share/primo/snapshots/<id>. --dry-run lists what it would take. "
                                    "Files that may hold secrets (calendar links, snippets, launcher history) are left out unless --include-sensitive. "
                                    "list, show ID and remove ID manage the snapshots. Writes nothing outside the snapshots folder.")
    sp.add_argument("action", nargs="?", metavar="create|list|show|remove")
    sp.add_argument("id", nargs="?", help="a snapshot id, for show and remove")
    sp.add_argument("--include-sensitive", action="store_true", help="also take files that may hold secrets")
    sp.add_argument("--dry-run", action="store_true", help="only list what would be taken")
    sp.add_argument("--json", action="store_true", help="machine-readable output on stdout")
    sp.add_argument("--no-color", action="store_true", help="never use colours")
    sp.set_defaults(fn=cmd_snapshot)
    sp = sub.add_parser("restore", help="show what restoring a snapshot would change, or restore it with --apply",
                        description="Compares the files in snapshot ID with the files you have now and lists what would be created or replaced; "
                                    "with --apply it writes them, keeping a private copy of each replaced file and a journal, and --rollback JOURNAL "
                                    "puts them back. Files specific to this machine need --include-machine; --only NAME ... picks files.")
    sp.add_argument("id", nargs="?", help="a snapshot id (see `primo snapshot list`)")
    sp.add_argument("--apply", action="store_true", help="really write the files (without it nothing is written)")
    sp.add_argument("--rollback", metavar="JOURNAL", help="undo a restore from its journal id")
    sp.add_argument("--only", nargs="+", metavar="NAME", help="only these files")
    sp.add_argument("--include-machine", action="store_true", help="also restore files that are specific to this machine")
    sp.add_argument("--json", action="store_true", help="machine-readable output on stdout")
    sp.add_argument("--no-color", action="store_true", help="never use colours")
    sp.set_defaults(fn=cmd_restore)
    sp = sub.add_parser("update", help="is this checkout ready for a manual update? (read-only)",
                        description="check: looks at the git checkout, your settings files, the tools Primo needs and your last settings snapshot, "
                                    "and says whether `git pull` is safe to try. Never fetches, pulls or changes anything.")
    sp.add_argument("action", nargs="?", metavar="check")
    sp.add_argument("--remote", action="store_true", help="also ask GitHub for the latest release (the only network access; off unless you add it)")
    sp.add_argument("--json", action="store_true", help="machine-readable output on stdout")
    sp.add_argument("--no-color", action="store_true", help="never use colours")
    sp.set_defaults(fn=cmd_update)
    args = p.parse_args(argv)
    if not getattr(args, "fn", None):
        p.print_help(sys.stderr)
        return 64
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
