# What does not belong in the repo: files scripts/theme-switch generates, files that are specific to one machine,
# backups, and anything that could hold a secret or personal data. Comments sit on their own lines: a # after a
# pattern would be part of the pattern.

# ---- Generated by scripts/theme-switch (written again on every theme change)
config/hypr/theme.lua
config/hypr/theme.env
config/hypr/confirm.css
config/hypr/hyprpaper.conf
config/hypr/hyprlock-theme.conf
config/hypr/logo.svg
config/hypr/logo.png
config/waybar/theme.css
config/waybar/style.css
config/wofi/style.css
config/wofi/menu.css
config/swaync/style.css
config/swayosd/style.css
config/dunst/dunstrc.d/
config/kitty/theme.conf

# ---- Generated for the SDDM login theme (scripts/install-sddm-theme.sh copies it to /usr/share)
sddm/primo/theme.conf
sddm/primo/logo.svg
sddm/primo/background.*

# ---- Other generated output
# the VS Code theme extension
vscode/
# the Plymouth boot splash
boot/

# ---- Specific to one machine: written by Primo Settings or by hand
config/hypr/local.lua
config/hypr/displays.lua
config/hypr/apprules.lua
# written by nwg-displays in hyprlang format, which the Lua config does not read
config/hypr/monitors.conf
config/hypr/workspaces.conf

# ---- Backups the installers make (<app>.bak-<timestamp>, <file>.bak-primo)
*.bak
*.bak-*

# ---- Secrets and personal files: never commit these
# password databases, VPN profiles and calendar links
*.kdbx
*.ovpn
*.ics
# keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
# environment files and credentials
.env
.env.*
!.env.example
.netrc
credentials.json

# ---- Release tooling: CI copies .github/release/package*.json to the root and installs it there
node_modules/
/package.json
/package-lock.json

# ---- Logs, caches, editors, operating system
*.log
.cache/
__pycache__/
*.pyc
.venv/
venv/
*.swp
*~
*.orig
*.rej
.vscode/
.idea/
.DS_Store
Thumbs.db
